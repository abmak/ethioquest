// EthioQuest — PostgreSQL schema for the three-feature service:
//   1. Let's Know Ethiopia  (quiz pool, attempts, leaderboards, prizes)
//   2. Let's Travel          (Ethiopian destinations and preference matching)
//   3. Share My Experience   (travel stories, likes and comments)
//
// The database is intentionally separate from the legacy Addis Gebeta schema.
// Create/update it with `npm run db:migrate --workspace backend`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  CHOICE
  TRUE_FALSE
  MATCHING
  IMAGE
}

enum DestinationCategory {
  HISTORY
  HERITAGE
  NATURE
  WILDLIFE
  ADVENTURE
  CULTURE
  CITY
  FOOD
}

enum PrizeStatus {
  PENDING
  PAID
  VOID
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String    @unique
  displayName       String
  passwordHash      String
  passwordChangedAt DateTime?
  bio               String?   @db.Text
  avatarUrl         String?
  region            String?
  // USER | MODERATOR | ADMIN
  role              String    @default("USER")
  banned            Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  attempts           QuizAttempt[]
  quizPayments       QuizPayment[]
  experiences        ExperiencePost[]
  experienceLikes    ExperienceLike[]
  experienceComments ExperienceComment[]
  prizes             PrizeAward[]
  following          Follow[]        @relation("Follower")
  followers          Follow[]        @relation("Following")
  messagesSent       DirectMessage[] @relation("MessageSender")
  messagesReceived   DirectMessage[] @relation("MessageRecipient")

  @@index([createdAt(sort: Desc)])
  @@index([role])
}

// ---------------------------------------------------------------------------
// Let's Know Ethiopia
// ---------------------------------------------------------------------------

// A single pool holds all four question shapes. `correctIndex` is used by
// CHOICE, TRUE_FALSE and IMAGE; MATCHING stores its left/right pairs in
// `matchPairs` and the shuffled right-hand choices in `matchOptions`.
model QuizQuestion {
  id           String       @id @default(cuid())
  key          String       @unique
  type         QuestionType
  prompt       String       @db.Text
  category     String
  difficulty   String       @default("MEDIUM")
  explanation  String?      @db.Text
  region       String?
  // Image questions
  imageUrl     String?      @db.Text
  imageCredit  String?      @db.Text
  imageLicense String?      @db.Text
  // CHOICE / TRUE_FALSE / IMAGE
  options      String[]     @default([])
  correctIndex Int?
  // MATCHING
  matchPairs   Json?
  matchOptions String[]     @default([])
  // CURATED | GENERATED
  source       String       @default("CURATED")
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())

  @@index([type, active])
  @@index([category, active])
  @@index([active])
}

// One row per play. A member gets one free play per Ethiopian calendar day and
// up to nine paid retries (3 ETB each), so `playIndex` runs 0..9 inside a day.
// A row is created when the play starts and completed when they submit. Daily,
// weekly and monthly leaderboards use each member's best completed play.
model QuizAttempt {
  id             String    @id @default(cuid())
  userId         String
  day            String
  // 0 = the free daily play, 1..9 = paid retries.
  playIndex      Int       @default(0)
  paid           Boolean   @default(false)
  weekKey        String
  monthKey       String
  questionIds    String[]
  answers        Json      @default("[]")
  score          Int       @default(0)
  maxScore       Int       @default(100)
  correctCount   Int       @default(0)
  totalQuestions Int       @default(10)
  durationMs     Int?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment QuizPayment?

  @@unique([userId, day, playIndex])
  @@index([day, score(sort: Desc), durationMs])
  @@index([weekKey, score(sort: Desc), durationMs])
  @@index([monthKey, score(sort: Desc), durationMs])
  @@index([userId, completedAt(sort: Desc)])
}

// Record of a 3 ETB retry. Payment is confirmed manually by the member (cash or
// mobile money) and logged here so staff can review it later; a row is always
// created together with the paid attempt it unlocks.
model QuizPayment {
  id        String   @id @default(cuid())
  userId    String
  attemptId String   @unique
  day       String
  playIndex Int
  amountEtb Int      @default(3)
  // TELEBIRR | CBE_BIRR | CASH
  method    String
  reference String?
  // CONFIRMED | VOID
  status    String   @default("CONFIRMED")
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([day, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// Prize configuration: one row per winning rank in a period. Staff choose the
// prize type, its optional photo and the amount, so the number of rows is the
// number of winners for DAILY, WEEKLY or MONTHLY.
model PrizeTier {
  id          String   @id @default(cuid())
  // DAILY | WEEKLY | MONTHLY
  period      String
  rank        Int
  name        String   @db.Text
  description String?  @db.Text
  amountEtb   Int?
  imageUrl    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([period, rank])
  @@index([period])
}

// A snapshot of a period's winners. Finalising locks the prizes that were
// configured at that moment, so later play cannot change a paid result.
model PrizeAward {
  id          String      @id @default(cuid())
  // DAILY | WEEKLY | MONTHLY
  period      String      @default("MONTHLY")
  // The period key: YYYY-MM-DD, YYYY-Www or YYYY-MM.
  periodKey   String
  rank        Int
  userId      String
  name        String      @db.Text
  description String?     @db.Text
  amountEtb   Int?
  imageUrl    String?     @db.Text
  status      PrizeStatus @default(PENDING)
  note        String?
  awardedAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([period, periodKey, rank])
  @@index([period, periodKey])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Let's Travel
// ---------------------------------------------------------------------------

model Destination {
  id           String              @id @default(cuid())
  slug         String              @unique
  name         String
  region       String
  city         String?
  category     DestinationCategory
  tagline      String
  summary      String              @db.Text
  description  String              @db.Text
  highlights   String[]            @default([])
  activities   String[]            @default([])
  bestTime     String
  gettingThere String              @db.Text
  entryFee     String?
  durationDays Int                 @default(2)
  budgetLevel  Int                 @default(2)
  lat          Float
  lng          Float
  imageUrl     String              @db.Text
  // Attribution for the bundled Wikimedia Commons photo.
  imageCredit  String?
  gallery      String[]            @default([])
  rating       Float               @default(0)
  reviewCount  Int                 @default(0)
  featured     Boolean             @default(false)
  tags         String[]            @default([])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  experiences ExperiencePost[]

  @@index([region, category])
  @@index([featured])
  @@index([budgetLevel])
}

// ---------------------------------------------------------------------------
// Share My Travel Experience
// ---------------------------------------------------------------------------

model ExperiencePost {
  id              String    @id @default(cuid())
  authorId        String
  title           String
  body            String    @db.Text
  destinationId   String?
  destinationName String
  region          String
  rating          Int?
  travelDate      DateTime?
  imageUrls       String[]  @default([])
  likeCount       Int       @default(0)
  commentCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  author      User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  destination Destination?        @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  likes       ExperienceLike[]
  comments    ExperienceComment[]

  @@index([createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([destinationId])
}

model ExperienceLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post ExperiencePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt(sort: Desc)])
}

model ExperienceComment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  body      String    @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  post   ExperiencePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// ---------------------------------------------------------------------------
// Community: follows and direct messages
// ---------------------------------------------------------------------------

// One row per follow edge. `followerId` follows `followingId`.
model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt(sort: Desc)])
}

// A one-to-one conversation is derived from the two member ids, so every
// message is stored once with its sender and recipient.
model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String    @db.Text
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  sender    User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt(sort: Desc)])
  @@index([recipientId, readAt])
}

// Small key/value store for operator settings and one-off migration markers.
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Staff access control and audit trail
// ---------------------------------------------------------------------------

// User.role stores Role.name. The three built-in roles are seeded and cannot be
// deleted; administrators can add custom roles and tune every permission list
// (the ADMIN role is kept with the full set so staff can never lock themselves
// out).
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  description String?
  permissions String[] @default([])
  builtIn     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Append-only staff activity trail. Actor values are snapshots, not relations,
// so the record stays readable after an account is removed.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String
  actorRole  String
  action     String
  targetType String
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@index([action])
}
