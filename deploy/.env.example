# Server-side environment for the VPS stack (deploy/docker-compose.prod.yml).
# Copy to `.env` next to the compose file on the server.
# Never commit the real `.env`.

# --- Public entry point -----------------------------------------------------
# Hostname whose DNS A/AAAA record points at this VPS. Caddy obtains the
# certificate on first start. Empty DOMAIN runs the stack over plain HTTP on
# WEB_PORT and the deploy scripts clear COOKIE_SECURE, because a browser drops
# Secure cookies over HTTP and every action would look signed out.
DOMAIN=

# Direct HTTP port for the web container (loopback when a TLS proxy is enabled).
WEB_PORT=8080
WEB_BIND=127.0.0.1

# Set to 1 when HTTPS is terminated by something other than the compose Caddy
# (the host's own nginx): keeps the web container on loopback and keeps the
# session cookie Secure instead of downgrading it for plain HTTP.
BEHIND_TLS_PROXY=

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=ethioquest
POSTGRES_DB=ethioquest
# Generated on the first deploy when empty.
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Auth -------------------------------------------------------------------
# Generated on the first deploy when empty (48 random bytes, hex).
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=7
# Empty follows NODE_ENV (on in production). The no-domain path in deploy.sh
# and update.sh turns it off because there is no TLS to carry the cookie yet.
COOKIE_SECURE=
# Comma-separated emails promoted to ADMIN when they register or sign in.
ADMIN_EMAILS=

# Origin allowed to call the API, e.g. https://196.189.155.179
# Filled from DOMAIN on the first deploy when empty.
CLIENT_ORIGIN=
CORS_EXTRA_ORIGINS=
# Reverse proxies in front of the API: 1 = the web container's nginx,
# 2 = plus a TLS proxy on the host.
TRUST_PROXY=1

# Leave empty to keep media URLs same-origin (served through the web container).
PUBLIC_API_URL=
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# --- Images -----------------------------------------------------------------
# CI publishes both images for every push to main; update.sh follows `latest`.
API_IMAGE=ghcr.io/abmak/ethioquest/api:latest
WEB_IMAGE=ghcr.io/abmak/ethioquest/web:latest
